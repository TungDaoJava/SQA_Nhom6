# ==============================================================================
# ROUTINE FASHION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .env nếu muốn tùy chỉnh cổng/mật khẩu local:
#   cp .env.example .env
# Sau đó điều chỉnh các giá trị bên dưới cho phù hợp với môi trường triển khai.
# ==============================================================================

# --- Cấu hình PostgreSQL local (Docker Compose) ---
DB_PORT=5432
DB_NAME=routine_db
DB_USER=routine
DB_PASSWORD=routine_dev_password

# --- Cấu hình Backend Spring Boot ---
BACKEND_PORT=8080
JWT_SECRET=RoutineSuperSecretKeyForGraduationProjectChangeMeInProduction20242025ABCDEF_CHANGE_THIS_ON_PRODUCTION

# --- Cloudflare R2 product image uploads ---
# Create a bucket, an R2 S3 API token (Object Read & Write), and enable public reads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://images.example.com or https://pub-....r2.dev
R2_PUBLIC_BASE_URL=

# --- Cấu hình Frontend static web server ---
FRONTEND_PORT=5173
# Public URL of the backend API used by Docker frontend builds.
VITE_API_BASE_URL=http://localhost:8080/api/v1
