# ==============================================================================
# ROUTINE FASHION - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Sao chép file này thành .env nếu muốn tùy chỉnh cổng/mật khẩu local:
#   cp .env.example .env
# Sau đó điều chỉnh các giá trị bên dưới cho phù hợp với môi trường triển khai.
# ==============================================================================

# --- Cấu hình PostgreSQL local (Docker Compose) ---
DB_PORT=5432
DB_NAME=routine_db
DB_USER=routine
DB_PASSWORD=routine_dev_password

# --- Cấu hình Backend Spring Boot ---
BACKEND_PORT=8080
JWT_SECRET=RoutineSuperSecretKeyForGraduationProjectChangeMeInProduction20242025ABCDEF_CHANGE_THIS_ON_PRODUCTION

# --- Cấu hình Frontend Nginx Web Server ---
FRONTEND_PORT=5173
